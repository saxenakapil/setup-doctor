{
  "name": "setup-doctor",
  "version": "0.1.0",
  "description": "Score and improve your AI coding agent setup. Local-only, open source.",
  "license": "MIT",
  "author": "Kapil Saxena",
  "type": "module",
  "bin": {
    "setup-doctor": "dist/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "skills-cursor",
    ".claude-plugin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saxenakapil/setup-doctor.git"
  },
  "homepage": "https://github.com/saxenakapil/setup-doctor#readme",
  "bugs": {
    "url": "https://github.com/saxenakapil/setup-doctor/issues"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "audit",
    "cli",
    "claude-plugin",
    "developer-tools"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:network": "node scripts/check-no-network.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "check:em-dash": "node scripts/check-no-em-dash.mjs",
    "check": "npm run typecheck && npm test && npm run check:network && npm run check:version && npm run check:em-dash",
    "smoke:publish": "node scripts/smoke-publish.mjs",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  }
}
